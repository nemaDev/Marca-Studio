{
  "name": "marca-studio",
  "version": "1.0.0",
  "description": "Crea logos y aplica marcas de agua a tus imágenes.",
  "author": "Marca Studio",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "electron .",
    "dist": "npm run build && node scripts/package.mjs",
    "lint": "oxlint src electron scripts"
  },
  "dependencies": {
    "lucide-react": "^0.577.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.1.2",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.86.0",
    "vite": "^8.3.2",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.marcastudio.desktop",
    "productName": "Marca Studio",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    }
  },
  "allowScripts": {
    "electron@44.5.1": true,
    "esbuild@0.25.12": true
  }
}
